mainmenu "SNMP agent sample"

config SAMPLE_TRAP_MANAGER
	string "Address of the manager to send traps to"
	default "127.0.0.1"
	help
	  Dotted-quad address of the manager that should receive this sample's
	  traps, in the form net_snmp_agent_trap_dst_set() expects. Traps go to
	  CONFIG_SNMP_AGENT_TRAP_PORT there.

	  The default suits native_sim built with overlay-host.conf, where
	  snmptrapd runs on the same machine as the simulator.

config SAMPLE_TRAP_PERIOD_SECONDS
	int "Seconds between demonstration traps"
	default 10
	range 0 3600
	help
	  How often to send the enterprise-specific trap that demonstrates
	  carrying a variable binding. Set to 0 to send only the cold start
	  trap at boot.

source "Kconfig.zephyr"
